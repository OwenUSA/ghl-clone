# Copy to .env.prod on the server, fill in, and chmod 600. Never commit .env.prod.
#
#   cp .env.example .env.prod && chmod 600 .env.prod

# The hostname Traefik routes to, and the only place the domain appears.
APP_HOST=crm.dreamteamroofingfl.com

# Host PostgreSQL 18, reached over the docker bridge via extra_hosts.
# The ghl_clone role needs a matching scram-sha-256 line in pg_hba.conf for the
# docker subnet (172.16.0.0/12), following the same pattern as the other stacks
# already on that host.
DATABASE_URL=postgresql+psycopg://ghl_clone:CHANGEME@host.docker.internal:5432/dtr_ghl_clone

# REQUIRED. Generate once with:  openssl rand -base64 48
#
# If this is unset the app generates a secret and writes it to backend/.jwt_secret
# INSIDE the container's writable layer (backend/app/auth.py:109-130). Every
# rebuild and every restart would then hold a different key, so every browser
# session breaks with "401 invalid token" on the next request. API tokens
# (ghl_pat_...) are sha256 digests in the database and would keep working, so the
# CLI and the telephony ingest would look healthy while every human is locked out.
JWT_SECRET=CHANGEME

# Session cookies must be HTTPS-only in production. Defaults to 0 in code
# (backend/app/main.py:1378), which would let them travel over plaintext.
COOKIE_SECURE=1

# Leave unset. It defaults to 0 on Postgres (backend/app/main.py:47), which is
# what we want -- alembic owns the schema, not create_all().
# AUTO_CREATE_ALL=

# ---------------------------------------------------------------------------
# The CRM link to owen-main (telephony). THIS IS THE SWITCH THAT ARMS REAL SENDS.
# ---------------------------------------------------------------------------
#
# With BOTH of the first two set, `get_transport()` returns CrmLinkTransport and
# `ghl msg send` / the Conversations composer hand the message to owen-main for
# delivery over the real BulkVS DID. With EITHER unset the app uses
# LoggingTransport and transmits nothing, which is what every environment does
# today. `GET /api/health` reports which one is wired (`"crm_link": true|false`).
#
# Arm this deliberately, and test with one message to a number you control.
# owen-main enforces its own destination allowlist server-side; do not try to
# duplicate or bypass it from here.
#
# The API key must carry owen-main's `crm_link` scope (mint it in the OWEN UI
# under API Keys). It is NOT the same credential as the ghl_pat_ token owen-main
# uses to post into /api/events in the other direction.
# CRM_LINK_BASE_URL=http://callmon_app:8888
# CRM_LINK_API_KEY=owen_sk_...
#
# The bound DID to call and text FROM. Defaults to +19544829099 in code; set it
# here only if the bound number changes.
# CRM_LINK_FROM_NUMBER=+19544829099
#
# Seconds to wait on owen-main before giving up. A timeout is recorded as FAILED
# (retryable), never as REFUSED (deliberate) -- see backend/app/crmlink.py.
# CRM_LINK_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# Measurement harness only (capture/). Not needed to run or deploy the app.
# ---------------------------------------------------------------------------

# The GoHighLevel location (sub-account) id to measure. Deliberately not
# committed: it addresses a real GHL account. capture/ghl_account.py is the one
# place that reads it, and every capture script imports from there.
GHL_LOCATION_ID=

# The app account the harness signs in as. Neither has a default -- a real
# address hardcoded in the source is exactly what should not be committed.
GHL_APP_EMAIL=
GHL_APP_PASSWORD=
