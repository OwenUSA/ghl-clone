# Copy to .env.prod on the server, fill in, and chmod 600. Never commit .env.prod.
#
#   cp .env.example .env.prod && chmod 600 .env.prod

# The hostname Traefik routes to, and the only place the domain appears.
APP_HOST=crm.dreamteamroofingfl.com

# Host PostgreSQL 18, reached over the docker bridge via extra_hosts.
# The ghl_clone role needs a matching scram-sha-256 line in pg_hba.conf for the
# docker subnet (172.16.0.0/12), following the same pattern as the other stacks
# already on that host.
DATABASE_URL=postgresql+psycopg://ghl_clone:CHANGEME@host.docker.internal:5432/dtr_ghl_clone

# REQUIRED. Generate once with:  openssl rand -base64 48
#
# If this is unset the app generates a secret and writes it to backend/.jwt_secret
# INSIDE the container's writable layer (backend/app/auth.py:109-130). Every
# rebuild and every restart would then hold a different key, so every browser
# session breaks with "401 invalid token" on the next request. API tokens
# (ghl_pat_...) are sha256 digests in the database and would keep working, so the
# CLI and the telephony ingest would look healthy while every human is locked out.
JWT_SECRET=CHANGEME

# Session cookies must be HTTPS-only in production. Defaults to 0 in code
# (backend/app/main.py:1378), which would let them travel over plaintext.
COOKIE_SECURE=1

# Leave unset. It defaults to 0 on Postgres (backend/app/main.py:47), which is
# what we want -- alembic owns the schema, not create_all().
# AUTO_CREATE_ALL=

# ---------------------------------------------------------------------------
# The CRM link to owen-main (telephony). THIS IS THE SWITCH THAT ARMS REAL SENDS.
# ---------------------------------------------------------------------------
#
# With BOTH of the first two set, `get_transport()` returns CrmLinkTransport and
# `ghl msg send` / the Conversations composer hand the message to owen-main for
# delivery over the real BulkVS DID. With EITHER unset the app uses
# LoggingTransport and transmits nothing, which is what every environment does
# today. `GET /api/health` reports which one is wired (`"crm_link": true|false`).
#
# Arm this deliberately, and test with one message to a number you control.
# owen-main enforces its own destination allowlist server-side; do not try to
# duplicate or bypass it from here.
#
# The API key must carry owen-main's `crm_link` scope (mint it in the OWEN UI
# under API Keys). It is NOT the same credential as the ghl_pat_ token owen-main
# uses to post into /api/events in the other direction.
# CRM_LINK_BASE_URL=http://callmon_app:8888
# CRM_LINK_API_KEY=owen_sk_...
#
# THE LINE THIS CRM CALLS AND TEXTS FROM. Defaults to +19547758492 in code
# (`crmlink.DEFAULT_FROM_NUMBER`), which is the DID bound to the CRM in owen-main as of
# 2026-09-16 — it replaced +19544829099, which is now FULLY UNBOUND and is nobody's CRM
# line. Set this only when the bound number changes again.
#
# It is the ONE definition. `GET /api/connection-status` reports it to the browser as
# `our_line`, and every screen that says "Sending from", "Calling from" or names the line
# in the AI escalation copy reads it from there — so changing the number is this variable
# and a restart, not a hunt through the frontend. Messages already on a thread keep the
# number they were actually sent on; nothing relabels history.
CRM_LINK_FROM_NUMBER=+19547758492
#
# Seconds to wait on owen-main before giving up. A timeout is recorded as FAILED
# (retryable), never as REFUSED (deliberate) -- see backend/app/crmlink.py.
# CRM_LINK_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# CompanyCam job photos (2026-09-14) -- see backend/app/companycam.py
# ---------------------------------------------------------------------------
# Empty = the feature is OFF: the Photos tab says so and nothing is sent anywhere.
# Read by the API (Photos tab, image relay) AND the worker (hourly check, project
# creation), so both containers need it -- .env.prod feeds both.
# COMPANYCAM_API_TOKEN=
#
# DEFAULTS TO TRUE once a token is set (operator decision, 2026-09-14): a card created
# in the CRM or by an AHS email, with an address (or when its first address is saved),
# gets a CompanyCam project -- searched for first, created only if none exists at that
# address. Workiz-imported cards never create. Set false to switch creation off.
# COMPANYCAM_CREATE_PROJECTS=true
#
# The hourly linking check. DEFAULT FALSE: turn it on after the first
# `python -m app.companycam_link --commit` run.
# COMPANYCAM_SYNC_ENABLED=false
#
# Seconds between pages of a bulk read (linking run, hourly check, search).
# COMPANYCAM_PACE_SECONDS=0.25

# ---------------------------------------------------------------------------
# AI Agents (2026-09-15) -- see backend/app/ai/
# ---------------------------------------------------------------------------
# The Fernet key provider API keys are encrypted under. Unset = Settings -> AI
# Connections refuses to save a connection (with this sentence); nothing else breaks.
# Read by the API (saving, Test, Try-it) AND the worker (agent runs): .env.prod feeds both.
# Generate ONCE and keep it: changing it makes every saved API key unreadable (each
# connection then asks for its key again).
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# AI_SECRETS_KEY=
#
# There is deliberately no switch here that turns an agent on: every agent is created
# Off, and Settings -> AI Connections has "Pause all AI agents".

# ---------------------------------------------------------------------------
# Pictures on a text message (2026-09-16). WHERE THE PHOTOGRAPHS LIVE.
# ---------------------------------------------------------------------------
#
# The CRM keeps its OWN copy of every inbound MMS, because carrier media links expire.
# The bytes go on disk, not in Postgres — a `pg_dump` taken to look at 800 contacts
# should not carry a gigabyte of JPEG.
#
# LEAVE THIS UNSET IN PRODUCTION. Dockerfile.api already sets it to
# /var/lib/ghl-clone/media, which is exactly where docker-compose.prod.yml mounts the
# named `media` volume, so the path and the mount come from the same repository and
# cannot drift. Setting it here to anything else writes pictures into the container's
# own filesystem, where the next `./deploy.sh` deletes them — and the symptom is a
# thread of "Picture unavailable" bubbles that looks like a carrier problem.
#
# `GET /api/health` reports `"media_writable": true|false`. Check it after a deploy.
# Locally it defaults to ./var/media relative to wherever you started the process.
# MEDIA_ROOT=

# ---------------------------------------------------------------------------
# Zuper (2026-09-16). OFF unless ZUPER_SYNC_ENABLED=true AND the Settings -> Zuper switch is
# on (which needs a passed setup check). See DECISIONS.md, 2026-09-16, Zuper.
# ---------------------------------------------------------------------------

# The master switch. false (the default) = zero requests to Zuper, nothing queued, and the
# webhook answers 503. The operator's commands (app.zuper.setup / app.zuper.load) need only a key.
ZUPER_SYNC_ENABLED=false
# The CRM Sync user's API key. Or ZUPER_API_KEY_FILE=/path/to/0600/file. Never print it.
ZUPER_API_KEY=
# ZUPER_API_KEY_FILE=
# The company's data centre (the setup check confirms it when ZUPER_COMPANY_NAME is set).
ZUPER_BASE_URL=https://us-east-1.zuperpro.com/api
# ZUPER_COMPANY_NAME=Dream Team Roofing
# The shared secret Zuper's webhook sends in the X-Webhook-Token header.
# Generate once with:  openssl rand -hex 32
ZUPER_WEBHOOK_TOKEN=
# Only if Zuper turns out to sign deliveries (HMAC-SHA256 of the body).
# ZUPER_WEBHOOK_SECRET=
# Where "CRM Link" fields point.
# ZUPER_CRM_BASE_URL=https://crm.dreamteamroofingfl.com
# How the "Managed in Zuper" badge links a job (UNVERIFIED default; empty = no link).
# ZUPER_JOB_URL_TEMPLATE=https://app.zuperpro.com/jobs/{uid}/details
# Pacing under the account's 200/min, and the sweep interval.
# ZUPER_REQUESTS_PER_MINUTE=180
# ZUPER_SWEEP_MINUTES=15

# ---------------------------------------------------------------------------
# Measurement harness only (capture/). Not needed to run or deploy the app.
# ---------------------------------------------------------------------------

# The GoHighLevel location (sub-account) id to measure. Deliberately not
# committed: it addresses a real GHL account. capture/ghl_account.py is the one
# place that reads it, and every capture script imports from there.
GHL_LOCATION_ID=

# The app account the harness signs in as. Neither has a default -- a real
# address hardcoded in the source is exactly what should not be committed.
GHL_APP_EMAIL=
GHL_APP_PASSWORD=
