# The API and the queue worker are the same image with different commands.
# Keeping them identical means the worker can never drift from the code that
# enqueued the job it is draining.
FROM python:3.12-slim

# uv is the locked Python tooling for this project (DECISIONS.md) -- pinned, not
# :latest, so a rebuild six months from now resolves the same dependency tree
# that uv.lock describes.
COPY --from=ghcr.io/astral-sh/uv:0.9.18 /uv /usr/local/bin/uv

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    # backend/app is deliberately NOT an installed package: pyproject.toml packages
    # only cli/ghl_cli, and `app` resolves in development purely because CLAUDE.md
    # says to `cd backend` first. Nothing in a container guarantees the working
    # directory, and uvicorn, the worker and alembic each run from different ones,
    # so put it on the path explicitly rather than relying on CWD.
    PYTHONPATH=/app/backend \
    # PICTURES (2026-09-16). Where the CRM keeps its own copy of every inbound MMS, and
    # every picture the composer has uploaded and not sent. Set HERE rather than left to
    # .env.prod so the path and the volume in docker-compose.prod.yml come from the same
    # repository and cannot drift: a MEDIA_ROOT that does not match the mount writes
    # pictures into the container's filesystem, where the next deploy deletes them.
    # .env.prod can still override it.
    MEDIA_ROOT=/var/lib/ghl-clone/media

# curl is for the container healthcheck, nothing else.
# chromium + fonts-dejavu-core (2026-11-07): Owen AI's make_inspection_report prints its HTML
# report to PDF headless (`chromium --headless --print-to-pdf`, app/owen_ai/report.py) and draws
# the photo labels in DejaVu Sans Bold. Only the owen_ai container runs it; the image is shared,
# so it costs every container ~300 MB of disk (no extra memory unless a report is printed).
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl chromium fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/* /usr/share/doc/* /usr/share/man/*

WORKDIR /app

# Dependencies first, so a source edit does not re-resolve the whole tree.
# cli/ has to come along: the project is its own package and hatch builds
# cli/ghl_cli, so `uv sync` fails without it.
COPY pyproject.toml uv.lock ./
COPY cli ./cli
# --no-dev drops pytest/ruff; the `capture` group (the live-GHL harness) is not a default group
# and is never installed here. Playwright itself IS a main dependency since 2026-11-12 (reading
# Frontdoor, app/frontdoor): it drives the Debian `chromium` installed above, and
# `playwright install` (its own browser download) is never run in this image.
RUN uv sync --frozen --no-dev

COPY backend ./backend
# Owen AI's workspace (2026-11-02): the CLAUDE.md, knowledge and skills its Claude Code reads.
# Only the owen_ai container uses it; its Claude login and sessions live in a volume.
COPY owen-ai ./owen-ai
ENV OWEN_AI_WORKSPACE=/app/owen-ai     CLAUDE_CONFIG_DIR=/var/lib/owen-ai/claude

ENV PATH="/app/.venv/bin:$PATH"

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
  CMD curl -fsS http://127.0.0.1:8000/api/health || exit 1

# --proxy-headers so the scheme and client IP behind Traefik are logged correctly.
# Migrations are NOT run here: `alembic upgrade head` is a release step in
# deploy.sh, so a schema change is a decision rather than a side effect of a
# restart. `python -m app.seed` must never appear here -- it calls drop_all().
CMD ["uvicorn", "app.main:app", \
     "--host", "0.0.0.0", "--port", "8000", \
     "--proxy-headers", "--forwarded-allow-ips", "*"]
