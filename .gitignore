.capture-profile/
captures/
references/
auth.json
node_modules/
__pycache__/
.venv/

# Generated JWT signing key. Never commit it — a committed key is a permanent
# token-forging key. Set JWT_SECRET in the environment for deployment instead.
backend/.jwt_secret

# Machine-local Claude Code settings (the shared ones live in .claude/settings.json).
.claude/settings.local.json

# Environment files. Every secret this project needs is env-driven (JWT_SECRET,
# DATABASE_URL, GHL_APP_PASSWORD, GHL_API_TOKEN), so an untracked .env is the
# difference between a deploy and a leak. .env.example is the committed template.
.env
.env.*
!.env.example

# Build output and packaging artefacts. NOTE: no blanket `build/` rule --
# capture/build/ is a real source directory, not an artefact.
/dist/
*.egg-info/

# Pictures the CRM keeps its own copy of (2026-09-16). MEDIA_ROOT defaults to ./var/media
# when nothing sets it, which is what a local `uvicorn` from backend/ does — those are real
# customers' photographs and must never reach a commit. In production the same path is a
# docker volume (docker-compose.prod.yml) and this rule is irrelevant.
var/media/
backend/var/media/

# Tool caches (each also self-ignores, but be explicit).
.ruff_cache/
.pytest_cache/

# Stray local databases. Tests use %TEMP%, but bootstrap can drop one here.
*.db
*.sqlite

# Client operational record: documents the customer's GoHighLevel account
# structure, inspection questionnaire, photo checklist and retired-system field
# inventory. Business data about a third party, not code. Kept locally, not
# published.
CHECKLIST-MIGRATION.md
